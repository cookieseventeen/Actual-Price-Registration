// 實價通 資料庫 schema (PostgreSQL)
// 依 InitialCreate migration 產生；欄位名沿用 EF 預設 PascalCase。
// 線上預覽/出圖：貼到 https://dbdiagram.io
//
// 列舉欄位（Provider/Plan/Status）在 DB 實際以 varchar(16) 字串儲存；
// 下方用 Enum 標示僅為語意清晰。

Project shijiatong {
  database_type: 'PostgreSQL'
  Note: '台中市實價登錄查詢服務 — districts / transactions / members / crawl_tasks'
}

Enum member_provider {
  google
  apple
}

Enum member_plan {
  free
  pro
  enterprise
}

Enum member_status {
  pending   [note: '待審核（註冊預設）']
  active    [note: '已啟用']
  rejected  [note: '已拒絕']
  suspended [note: '已停權']
}

Enum crawl_status {
  done
  running
  queued
  error
}

Enum member_role {
  member
  admin    [note: '後台最高權限；由 Auth:AdminEmails 設定驅動']
}

Table districts {
  Id           varchar(32)  [pk, note: '拼音代碼，如 xitun（台中 29 區）']
  Name         text         [not null, note: '西屯區']
  Zone         text         [null, note: '生活圈說明（原 12 區有，其餘 null）']
  AvgUnitPrice "numeric(6,2)" [not null, note: '近 12 個月平均單價（萬/坪，一般成屋、排除異常值）；重建時計算']
  ChangePct    "numeric(5,2)" [null, note: '近 12 個月 vs 前 12 個月（%，一般成屋）；前期樣本不足為 null']
  Volume       integer      [not null, note: '近 12 個月成交筆數']
  Lat          "double precision" [not null, note: '約略中心點（區公所附近）']
  Lng          "double precision" [not null]

  Note: '台中市行政區與統計（migration ReplaceDemoWithLvrData；統計由 /api/admin/lvr/rebuild 重算）'
}

Table transactions {
  Id         varchar(32)  [pk, note: '官方編號，如 RPQNMLMLRHLGFAB97DA']
  Community  text         [null, note: '社區名：買賣資料無此欄位 → null']
  DistrictId varchar(32)  [not null, note: 'FK → districts.Id（關聯定義見檔尾 Ref）']
  Road       text         [not null, note: '由門牌抽取的路段；抽不到為空字串']
  Address    text         [null, note: '去識別化門牌']
  Section    text         [null, note: '重劃區 / 生活圈：資料無此欄位 → null']
  Type       text         [not null, note: '住宅大樓 / 華廈 / 公寓 / 透天厝 / 套房']
  Total      integer      [not null, note: '總價（萬）']
  Unit       "numeric(6,2)" [not null, note: '單價（萬/坪，官方欄位）']
  Ping       "numeric(7,2)" [not null, note: '建物移轉總面積（坪，含車位）']
  Floor      text         [not null, note: '18/26、全/4、1-2/5']
  Age        integer      [null, note: '屋齡；建築完成年月空白為 null']
  Layout     text         [not null, note: '4房2廳']
  Rooms      integer      [not null]
  Trade      text         [not null, note: '成屋 / 預售屋（= 預售屋交屋，Date 為簽約日）']
  Date       date         [not null, note: '交易日']
  Source     text         [not null, note: '內政部']
  CrawledAt  timestamptz  [not null, note: '取得時間（UTC）']
  Lat        "double precision" [not null, note: '目前為行政區中心點']
  Lng        "double precision" [not null]
  Parking    text         [not null, note: '坡道平面 / … / 無']
  IsOutlier  boolean      [not null, default: false, note: '單價 < 5 或 > 200 萬/坪：保留顯示、統計排除']

  indexes {
    DistrictId
    Community
    Date
  }
  Note: '成交紀錄：由 lvr_staging_records 正規化後全量重建（已取代 demo 種子）'
}

Table members {
  Id         uuid          [pk]
  Name       text          [not null]
  Email      text          [not null, unique]
  Avatar     text          [not null, note: '顯示首字']
  Provider   member_provider [not null, note: 'DB 存 varchar(16)']
  Plan       member_plan     [not null, note: 'DB 存 varchar(16)']
  Status     member_status   [not null, note: 'DB 存 varchar(16)']
  Role       member_role     [not null, default: 'member', note: 'DB 存 varchar(16)；migration AddMemberRole']
  Purpose    text          [not null, note: '使用用途']
  CreatedAt  timestamptz   [not null]
  ReviewedAt timestamptz   [null, note: '最後審核時間']
  Note       text          [null]

  Note: '會員（SSO 註冊 + 後台審核），對應前端 Member'
}

Table crawl_tasks {
  Id           varchar(32) [pk, note: '如 C01']
  DistrictName text        [not null]
  Status       crawl_status [not null, note: 'DB 存 varchar(16)']
  Records      integer     [not null]
  LastRun      timestamptz [null, note: 'running 時為 null']
  Next         timestamptz [null]
  Duration     text        [not null, note: '4分12秒 / —']

  Note: '爬蟲任務狀態，對應前端 CrawlTask'
}

Enum lvr_import_status {
  Running
  Succeeded
  NoData    [note: '官方無此季別資料']
  Failed
}

Table lvr_staging_records {
  SerialNo        varchar(32)  [pk, note: '官方「編號」，重跑匯入的冪等鍵']
  County          varchar(4)   [not null, note: 'b = 台中']
  Kind            varchar(4)   [not null, note: 'a = 不動產買賣']
  District        varchar(16)  [not null, note: '鄉鎮市區']
  Fields          jsonb        [not null, note: '原始欄位（中文欄名 → 字串）']
  ContentHash     varchar(64)  [not null, note: 'Fields SHA-256，偵測官方更正']
  FirstSource     varchar(32)  [not null, note: '115S3 / current-20261031']
  LastSource      varchar(32)  [not null]
  FirstImportedAt timestamptz  [not null]
  UpdatedAt       timestamptz  [not null]
  LastRunId       uuid         [not null, note: '→ lvr_import_runs.Id（未設 FK）']

  indexes {
    District
    LastRunId
  }
  Note: '實價登錄開放資料原始列 staging（migration AddLvrStaging）'
}

Table lvr_import_runs {
  Id         uuid          [pk]
  Source     varchar(32)   [not null]
  Url        varchar(512)  [not null]
  Status     lvr_import_status [not null, note: 'DB 存 varchar(16)']
  StartedAt  timestamptz   [not null]
  FinishedAt timestamptz   [null]
  FromCache  boolean       [not null]
  RawRows    integer       [not null]
  Malformed  integer       [not null]
  Inserted   integer       [not null]
  Updated    integer       [not null]
  Unchanged  integer       [not null]
  Error      text          [null]

  indexes {
    StartedAt
  }
  Note: '每次匯入執行紀錄'
}

// 關聯
Ref: transactions.DistrictId > districts.Id [delete: restrict, update: no action]
