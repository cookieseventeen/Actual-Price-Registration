# 複製成 .env 後填入實際值（.env 已被 gitignore，勿提交）

# ── PostgreSQL ──
POSTGRES_DB=shijiatong
POSTGRES_USER=shijiatong
POSTGRES_PASSWORD=change-me-strong-password

# ── ASP.NET 環境 ──
# 容器正式環境用 Production；本機 dotnet run 可改 Development
ASPNETCORE_ENVIRONMENT=Production

# ── 對外發佈的主機 port（避開常見衝突）──
NGINX_HTTP_PORT=8090
POSTGRES_PORT=5433
REDIS_PORT=6380

# ── Auth（Stage 1+，預設皆關閉；與 appsettings Auth 區塊對應）──
# docker-compose.yml 的 api.environment 會把以下變數傳進容器（改完需重建 api 容器）。
# prod 開 admin 保護：Auth__Enabled=true、Auth__ProtectAdminEndpoints=true、Auth__Jwt__SigningKey=<至少 32 字元>
# ⚠️ prod 不要開 Auth__MockSsoEnabled（模擬 SSO 任何人都能拿到 admin token）
# Auth__Enabled=false
# Auth__ProtectAdminEndpoints=false
# Auth__MockSsoEnabled=false
# Auth__AdminEmails__0=cookieseventeen@gmail.com
# Auth__Jwt__Issuer=shijiatong
# Auth__Jwt__Audience=shijiatong-web
# Auth__Jwt__SigningKey=
# Auth__Jwt__AccessTokenMinutes=60

# ── 實價登錄開放資料匯入（/api/admin/lvr/*）──
# 預設 false；在 prod admin 保護真正生效前請保持關閉
# LVR_IMPORT_ENABLED=false

# ── Cloudflare Tunnel（之後填）──
# Zero Trust → Networks → Tunnels 建立後取得 token；填好再加 --profile tunnel 啟用
CLOUDFLARE_TUNNEL_TOKEN=
