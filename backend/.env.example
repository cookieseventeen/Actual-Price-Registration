# 複製成 .env 後填入實際值（.env 已被 gitignore，勿提交）

# ── PostgreSQL ──
POSTGRES_DB=shijiatong
POSTGRES_USER=shijiatong
POSTGRES_PASSWORD=change-me-strong-password

# ── ASP.NET 環境 ──
# 容器正式環境用 Production；本機 dotnet run 可改 Development
ASPNETCORE_ENVIRONMENT=Production

# ── 對外發佈的主機 port（避開常見衝突）──
NGINX_HTTP_PORT=8090
POSTGRES_PORT=5433
REDIS_PORT=6380

# ── Auth（Stage 1+，預設皆關閉；與 appsettings Auth 區塊對應）──
# Auth__Enabled=false
# Auth__ProtectAdminEndpoints=false
# Auth__MockSsoEnabled=false
# Auth__Jwt__Issuer=shijiatong
# Auth__Jwt__Audience=shijiatong-web
# Auth__Jwt__SigningKey=
# Auth__Jwt__AccessTokenMinutes=60

# ── Cloudflare Tunnel（之後填）──
# Zero Trust → Networks → Tunnels 建立後取得 token；填好再加 --profile tunnel 啟用
CLOUDFLARE_TUNNEL_TOKEN=
